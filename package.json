    "framer-motion": "^12.43.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "read-excel-file": "^9.3.10",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
